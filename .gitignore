.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Local WiFi credentials — never commit. Use secrets.example.h as the template.
src/secrets.h

# Printable field card — contains the WiFi password in plain text. Edit the SVG
# directly (or regenerate it); never commit.
field-guide.svg

# Machine-local Claude Code settings (COM ports, absolute paths, personal perms)
.claude/settings.local.json

# Referee PIN for the dashboard (server/app.py) — never commit.
server/ref_pin.txt
# Dashboard connection logs (server/app.py) — runtime data.
server/logs/
__pycache__/
# Dashboard runtime state (referee audio settings) and generated voice clips
# (rebuild with server/tools/make_clips.py).
server/state/
server/sounds/
